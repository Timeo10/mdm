# Application Environment
NODE_ENV=development

# Server Configuration
SERVER_URL=http://localhost
SERVER_PORT=3000

# Azure AD SAML Configuration
ENTRY_ID_URL=https://login.microsoftonline.com/YOUR_TENANT_ID/saml2
ENTRY_ID_ISSUER=https://sts.windows.net/YOUR_TENANT_ID/
SAML_CERT_PATH=./azure_ad_certificate.pem

# Frontend URL
CLIENT_URL=http://localhost:5173

# Database PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-password
DB_NAME=adv_mdm

# Session Secret (MUST be at least 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=change_this_to_a_secure_random_string_minimum_32_characters

# Optional: Database SSL CA Certificate Path (for production)
# DB_SSL_CA=/path/to/ca-certificate.crt
